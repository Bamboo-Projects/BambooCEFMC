@@ -1006,6 +1008,23 @@ void create(std::shared_ptr<JNIObjectsForCreate> objs,
 
   CefBrowserSettings settings;
 
+  // Windowless frame rate, overridable from the environment.
+  //
+  // CEF defaults to 30 fps for windowless browsers and the value is only
+  // settable through CefBrowserSettings at creation time. This fork predates
+  // the CefBrowserSettings binding, so there is no way to reach it from Java.
+  // Reading it here keeps a single binary able to serve both sides of an A/B
+  // comparison: JCEF_WINDOWLESS_FRAME_RATE=60 against the unset default.
+  //
+  // CEF accepts 1..60; anything outside that range is ignored so a typo
+  // cannot silently produce a browser that never paints.
+  if (const char* fps_text = std::getenv("JCEF_WINDOWLESS_FRAME_RATE")) {
+    const int fps = std::atoi(fps_text);
+    if (fps >= 1 && fps <= 60) {
+      settings.windowless_frame_rate = fps;
+    }
+  }
+
   if (transparent == JNI_FALSE) {
     // Specify an opaque background color (white) to disable transparency.
